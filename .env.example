# dev or prod or local
ENV="local"

# 1 or 0
DEBUG=1

# Database
DB_URL=postgresql+asyncpg://postgres:your-password@localhost:5432/agentic-rag
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379

# Embedding service
EMBEDDING_SERVICE_URL="http://localhost:8001/embeddings"
EMBEDDING_MODEL_NAME="all-MiniLM-L12-v2"
REQUEST_TIMEOUT=10.0

# SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
